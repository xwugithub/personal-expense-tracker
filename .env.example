# Copy this file to .env.local and fill in real values. Never commit .env.local
# or any file containing actual secrets — see docs/security.md.

# Local MongoDB connection string.
MONGODB_URI=mongodb://localhost:27017/expense-tracker

# NextAuth (Auth.js) — generate with `npx auth secret`. Rotating this value
# invalidates every existing session (see docs/auth.md).
AUTH_SECRET=changeme-generate-with-npx-auth-secret

# The app's canonical origin. Use http://localhost:3000 locally; the
# https:// production URL in every deployed environment (required so
# NextAuth applies secure, __Secure-prefixed cookies — see docs/auth.md).
AUTH_URL=http://localhost:3000
